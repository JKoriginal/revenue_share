generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id        Int      @id @default(autoincrement())
  epfNumber String   @unique
  name      String
  sectionId Int
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section     Section                     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  role        Role                        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignments ProductEmployeeAssignment[]
}

model Section {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees       Employee[]
  productSections ProductSection[]
}

model Role {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employees Employee[]
}

model Product {
  id        Int      @id @default(autoincrement())
  itemCode  String   @unique
  itemName  String
  revenue   Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections    ProductSection[]
  assignments ProductEmployeeAssignment[]
}

model ProductSection {
  id         Int     @id @default(autoincrement())
  productId  Int
  sectionId  Int
  percentage Decimal @db.Decimal(6, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([productId, sectionId])
}

model ProductEmployeeAssignment {
  id               Int     @id @default(autoincrement())
  productId        Int
  employeeId       Int
  rolePercentage   Decimal @db.Decimal(6, 2)
  calculatedAmount Decimal @db.Decimal(12, 2)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([productId, employeeId])
}
